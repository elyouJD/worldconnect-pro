rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function mutualLike(a, b) {
      return exists(/databases/$(database)/documents/likes/$(a + '_' + b))
        && exists(/databases/$(database)/documents/likes/$(b + '_' + a));
    }

    match /users/{uid} {
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.adultConfirmed == true;
      // Public profile fields only. Do not put private contact data in this collection.
      allow read: if signedIn() && (resource.data.visibility != 'hidden' || owner(uid) || admin());
      allow update: if owner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','country','city','purpose','languages','interests','bio',
          'photoURL','photoPublicId','visibility','online','lastSeen'
        ]);
      allow delete: if owner(uid) || admin();
    }

    match /privateUsers/{uid} {
      allow read, create, update, delete: if owner(uid) || admin();
    }

    match /likes/{likeId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.toUid;
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || admin());
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow update: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && matchId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && mutualLike(request.resource.data.participants[0], request.resource.data.participants[1]);
      allow update, delete: if admin();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && exists(/databases/$(database)/documents/matches/$(chatId))
        && get(/databases/$(database)/documents/matches/$(chatId)).data.participants == request.resource.data.participants;
      allow update, delete: if false;
      match /messages/{messageId} {
        function chatData() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if signedIn() && request.auth.uid in chatData().participants;
        allow create: if signedIn()
          && request.auth.uid in chatData().participants
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /blocks/{blockId} {
      allow create: if signedIn()
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid;
      allow read, delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.reason is string;
      allow read: if admin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if admin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if admin();
      allow write: if false;
    }
  }
}
