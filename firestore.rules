rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function chatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{uid} {
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.adultConfirmed == true;
      allow read: if signedIn() && (resource.data.visibility != 'hidden' || owner(uid) || admin());
      allow update: if owner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','country','city','purpose','languages','interests','bio',
          'photoURL','photoPublicId','visibility','online','lastSeen'
        ]);
      allow delete: if owner(uid) || admin();
    }

    match /privateUsers/{uid} {
      allow read, create, update, delete: if owner(uid) || admin();
    }

    match /likes/{likeId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.toUid;
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || admin());
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow update: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if admin();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage','lastMessageAt','updatedAt','lastSenderUid','unreadCounts'
        ]);
      allow delete: if admin();

      match /messages/{messageId} {
        function chatData() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if signedIn() && request.auth.uid in chatData().participants;
        allow create: if signedIn()
          && request.auth.uid in chatData().participants
          && request.resource.data.senderUid == request.auth.uid
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1000)
            ||
            (request.resource.data.type in ['image','video','audio']
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.matches('https://.*'))
          );
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && chatMember(request.resource.data.chatId)
        && request.resource.data.recipientUid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;
      allow read, delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }


    match /follows/{followId} {
      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingUid;
      allow read: if signedIn()
        && (resource.data.followerUid == request.auth.uid || resource.data.followingUid == request.auth.uid);
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','declined'];
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && friendshipId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.requestId is string
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid in request.resource.data.participants
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending';
      allow update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1200
        && (request.resource.data.text.size() > 0 || request.resource.data.mediaUrl.matches('https://.*'));
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','commentsDisabled','updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1200;
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['like','love','dislike'];
        allow delete: if signedIn() && (uid == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid);
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && get(/databases/$(database)/documents/posts/$(postId)).data.get('commentsDisabled', false) != true;
        allow update: if signedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid);
      }
    }

    match /blocks/{blockId} {
      allow create: if signedIn()
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid;
      allow read, delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.reason is string;
      allow read: if admin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if admin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if admin();
      allow write: if false;
    }
  }
}
